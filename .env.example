# ==================== CREDENTIALS ====================
# Steam API — get yours at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# PostgreSQL (Gold Layer — matches docker-compose postgres_general)
# Set these to any values you want; docker-compose will create the DB with them
DB_URL=jdbc:postgresql://postgres_general:5432/sessiondb
DB_USER=your_db_username
DB_PASS=your_db_password

# pgAdmin GUI credentials
PGADMIN_EMAIL=your_email@example.com
PGADMIN_PASS=your_pgadmin_password

# ==================== AIRFLOW SECRETS ====================
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_generated_fernet_key_here

# Any random string — used to sign Airflow web session cookies
AIRFLOW_SECRET_KEY=your_random_secret_key_here

# Airflow internal metadata DB credentials (separate from your game DB)
AIRFLOW_DB_USER=your_airflow_db_username
AIRFLOW_DB_PASS=your_airflow_db_password

# Airflow admin UI login
AIRFLOW_ADMIN_USER=your_admin_username
AIRFLOW_ADMIN_EMAIL=your_admin_email@example.com
AIRFLOW_ADMIN_PASS=your_admin_password

# ==================== PIPELINE CONFIG ====================
# How many games to fetch per run
BATCH_SIZE=1500
# How many hours before a game is considered stale and needs refreshing
STALE_HOURS=24
